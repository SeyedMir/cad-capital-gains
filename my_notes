# Build

sudo apt update
sudo apt install python3 python3-pip -y

## Install poetry
curl -sSL https://install.python-poetry.org | python3 -
### Add to .profile: export PATH="$HOME/.local/bin:$PATH"
### Test successful installation: poetry --version

## Set Python version in pyproject.toml to ">=3.9,<4.0". (Already done in hessam branck)

## Upgrade urllib3 to fix "ModuleNotFoundError: No module named 'urllib3.packages.six.moves'"
poetry add urllib3@latest

## Build and install the tool itself
poetry install

## Then run it
poetry run capgains
